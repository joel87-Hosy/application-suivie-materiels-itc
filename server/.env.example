# Required: Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# Optional: model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: local fallback mode when Gemini key/call is unavailable (true/false)
ENABLE_LOCAL_FALLBACK=true

# Optional: protect backend endpoint with Bearer token
CHAT_BACKEND_TOKEN=your_secure_token

# Optional: port (default: 8787)
PORT=8787

# Optional: CORS origins separated by comma
# Example: ALLOWED_ORIGINS=http://localhost:8080,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:8080
